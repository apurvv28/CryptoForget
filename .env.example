# =============================================================================
# CryptoForget Environment Configuration
# Copy this to .env and fill in values. NEVER commit .env to git.
# =============================================================================

# ---- Database (SQLite with async support) ----
DATABASE_URL=sqlite+aiosqlite:///./data/cryptoforget.db
DATABASE_ECHO=false

# ---- AWS S3 (Artifacts, Model Checkpoints & Deletion Manifests) ----
# Specify your dedicated AWS CLI profile name (DO NOT use default)
AWS_PROFILE=cryptoforget-profile
AWS_REGION=us-east-1
S3_BUCKET_NAME=cryptoforget-artifacts
# Optional custom S3 endpoint (e.g. for MinIO or localstack)
# S3_ENDPOINT_URL=http://localhost:4566

# ---- Auth ----
SECRET_KEY=change-this-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# ---- ML ----
MODEL_PATH=./models/distilgpt2
MODEL_REVISION=main
MAX_SEQ_LENGTH=128
PYTORCH_NUM_THREADS=3
PYTORCH_INTEROP_THREADS=1

# ---- Resource Guardrails ----
MAX_RSS_GB=6.0
MIN_AVAILABLE_GB=1.5
MAX_WALL_TIME_MINUTES=60

# ---- Certificate Signing ----
# Path to Ed25519 private key (DO NOT commit the actual key)
SIGNING_KEY_PATH=./signing_keys/private.pem
PUBLIC_KEY_PATH=./signing_keys/public.pem
SIGNING_KEY_ID=key-001

# ---- App ----
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:5173
